# Copy to .env and fill in. .env is git-ignored.
GROQ_API_KEY=your_groq_api_key_here

# Models (defaults work; change only if Groq renames them).
# Main model for the agents, a smaller fast one for routing/critique, and a backup used
# automatically when the other two hit Groq's free-tier rate limits.
LLM_MODEL=openai/gpt-oss-120b
ROUTER_MODEL=openai/gpt-oss-20b
BACKUP_MODEL=qwen/qwen3.8-27b
